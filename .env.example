# --- Tableau de bord ---
PORT=3000
# Mot de passe pour accéder au tableau de bord (obligatoire)
DASHBOARD_PASSWORD=change-moi
# Secret pour signer le cookie de session du dashboard (chaîne aléatoire longue)
SESSION_SECRET=remplace-par-une-chaine-aleatoire-longue
# Mettre à true si le dashboard est servi en HTTPS (cookie Secure)
COOKIE_SECURE=false
# Dossier où l'état (stats, historique, session WikiMasters) est stocké
DATA_DIR=./data

# --- API WikiMasters ---
# À vérifier dans les DevTools du navigateur (onglet Réseau) en ouvrant un paquet sur le site.
WM_BASE_URL=https://wikimasters.fr
# Endpoint appelé pour ouvrir un paquet (méthode POST). Peut aussi être une URL complète
# (ex. https://<projet>.supabase.co/functions/v1/open-pack).
WM_OPEN_PACK_PATH=/api/packs/open
# Optionnel : endpoint (GET) qui renvoie le nombre de paquets disponibles
WM_PACKS_STATUS_PATH=
# Optionnel : endpoint (POST) pour rafraîchir le token (mode "token")
WM_REFRESH_PATH=/api/auth/refresh
# WikiMasters utilise Supabase Auth (cookie sb-<projet>-auth-token). Avec ces deux valeurs,
# le bot renouvelle la session via Supabase au lieu de WM_REFRESH_PATH.
# URL du projet : https://<projet>.supabase.co ; clé "anon" (publique) : en-tête "apikey"
# visible dans l'onglet Réseau sur une requête vers *.supabase.co.
WM_SUPABASE_URL=
WM_SUPABASE_ANON_KEY=
# User-Agent envoyé à WikiMasters
WM_USER_AGENT=WikiMastersBot/1.0 (+self-hosted)

# --- Valeurs par défaut du bot (modifiables ensuite dans le dashboard) ---
DEFAULT_INTERVAL_MINUTES=50
DEFAULT_PACKS_PER_RUN=5
